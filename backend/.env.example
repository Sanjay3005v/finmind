# Copy to backend/.env and fill in real values. Never commit the real file.

# ── App ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
APP_SECRET_KEY=                   # openssl rand -hex 32 — used for app-level AES-GCM envelope encryption of broker creds
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ── Supabase (Postgres + Auth + Storage) ────────────────────────────────
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # server-side only, never expose to frontend
# Legacy HS256 fallback only — newer projects sign tokens with a per-project
# ES256 key verified via {SUPABASE_URL}/auth/v1/.well-known/jwks.json instead,
# which needs no secret. Set this only if your project still uses the legacy
# shared JWT secret (Project Settings → API → JWT Settings → Legacy JWT secret).
SUPABASE_JWT_SECRET=
# NOTE: the direct host (db.<ref>.supabase.co) often resolves to an IPv6-only
# address. If your network has no IPv6 route (getaddrinfo/ENETUNREACH errors),
# use the Session Pooler host instead — Project Settings → Database →
# Connection Pooling — format: postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ── Redis (cache, rate limiting, Celery broker) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM providers (primary → fallback → fallback) ───────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small

# ── Broker adapters (all default to paper/mock mode until set) ─────────
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
ANGELONE_API_KEY=
ANGELONE_CLIENT_CODE=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/brokers/upstox/callback
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=http://localhost:3000/brokers/fyers/callback

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
